#: online/handler.py:1497
#, python-format
msgid ""
"Confirmation stage has ended, there are %(confirmed_players)s players. Games "
"starts in 10 minutes at 7-30 AM UTC. Please, follow this link %(lobby_link)s "
"to enter the tournament lobby. Games will start automatically."
msgstr ""
"Die Bestätigungsphase ist beendet. %(confirmed_players)s Spieler haben "
"bestätigt. Spiele beginnen in 10 Minuten um 7:30 Uhr UTC. Bitte gehen Sie "
"über diesen Link %(lobby_link)s in die Turnierlobby. Spiele starten "
"automatisch."

#: online/handler.py:1504
#, python-format
msgid ""
"Game №%(game_index)s: %(players)s. Is not started. The table was moved to "
"the end of the queue."
msgstr ""
"Tisch №%(game_index)s: %(players)s. Nicht gestartet. Der Tisch wurde ans "
"Ende der Warteschlange verschoben."

#: online/handler.py:1507
msgid ""
"Game №%(game_index): %(players). Is not started. Missed players "
"%(missed_players). The table was moved to the end of the queue. \n"
"\n"
"%(missed_players_str) Missed players please enter the tournament lobby: "
"%(lobby_link)."
msgstr ""
"Tisch №%(game_index): %(players). Nicht gestartet. Fehlende Spieler: "
"%(missed_players). Der Tisch wurde ans Ende der Warteschlange verschoben.\n"
"\n"
"%(missed_players_str) Fehlende Spieler, bitte betreten Sie die "
"Turnierlobby: %(lobby_link)."

#: online/handler.py:1511
#, python-format
msgid "Game №%(game_index)s: %(players)s. Started."
msgstr "Tisch №%(game_index)s: %(players)s. Gestartet."

#: online/handler.py:1512
msgid "The tournament is over. Thank you for participating!"
msgstr "Das Turnier ist beendet. Vielen Dank für Ihre Teilnahme!"

#: online/handler.py:1513
#, python-format
msgid ""
"%(message)s\n"
"\n"
msgstr ""
"%(message)s\n"
"\n"

#: online/handler.py:1515
#, python-format
msgid ""
"Players: %(player_names)s please send link to game log.\n"
"\n"
"If there is no log when next round start, all players from this game will "
"get -30000 scores as a round result (their real scores will not be counted)."
msgstr ""
"Spieler: %(player_names)s, bitte senden Sie den Link zum Spielprotokoll.\n"
"\n"
"Fehlt das Protokoll beim Start der nächsten Runde, erhalten alle Spieler "
"dieses Spiels -30000 Punkte als Rundenergebnis (die echten Punkte werden "
"nicht gezählt)."

#: online/handler.py:1520
#, python-format
msgid ""
"Players: %(player_names)s you got -30000 penalty because of not sent link to "
