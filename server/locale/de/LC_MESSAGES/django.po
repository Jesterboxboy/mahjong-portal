#: online/handler.py:793
msgid "Game penalty added successfully."
msgstr "Spielstrafe erfolgreich hinzugefügt."

#: online/handler.py:1336
#, python-format
msgid ""
"Confirmation stage has begun! To confirm your tournament participation send "
"command \"/me <your tenhou nickname>\" (registry important!). Confirmation "
"stage will be ended at %(confirmation_end_time)s (%(timezone)s).\n"
"\n"
"Useful links:\n"
"- tournament lobby: %(lobby_link)s\n"
"- tournament rating table: %(rating_link)s\n"
msgstr ""
"Die Bestätigungsphase hat begonnen! Um Ihre Teilnahme zu bestätigen, senden "
"Sie den Befehl \"/me <Ihr Tenhou-Nickname>\" (Groß-/Kleinschreibung "
"beachten!). Die Phase endet um %(confirmation_end_time)s (%(timezone)s).\n"
"\n"
"Nützliche Links:\n"
"- Turnierlobby: %(lobby_link)s\n"
"- Turniertabelle: %(rating_link)s\n"

