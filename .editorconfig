# http://editorconfig.org
root = true

[*.*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
max_line_length = 120
indent_style = space

[*.{html,scss,css,js,json}]
indent_size = 4
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[Makefile]
indent_style = tab


